[Unit]
Description=Biometrics Frontend
Requires=backend.container
After=backend.container

[Container]
Pod=biometrics.pod
Image=localhost/frontend:latest
Environment=BACKEND_HOST=http://localhost:3000
Environment=SITE_HOST=192.168.1.0
Environment=SITE_HOST_ALT=sothea.local
Pull=never

[Service]
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
